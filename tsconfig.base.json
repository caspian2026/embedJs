{
    "compileOnSave": false,
    "compilerOptions": {
        "rootDir": ".",
        "sourceMap": true,
        "esModuleInterop": true,
        "declaration": false,
        "moduleResolution": "nodenext",
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "importHelpers": true,
        "target": "ES2022",
        "module": "NodeNext",
        "lib": ["ES2022"],
        "skipLibCheck": true,
        "skipDefaultLibCheck": true,
        "baseUrl": ".",
        "paths": {
            "@caspian2026/embedjs": ["core/embedjs/src/index.ts"],
            "@caspian2026/embedjs-anthropic": ["models/embedjs-anthropic/src/index.ts"],
            "@caspian2026/embedjs-cohere": ["models/embedjs-cohere/src/index.ts"],
            "@caspian2026/embedjs-huggingface": ["models/embedjs-huggingface/src/index.ts"],
            "@caspian2026/embedjs-interfaces": ["core/embedjs-interfaces/src/index.ts"],
            "@caspian2026/embedjs-llama-cpp": ["models/embedjs-llama-cpp/src/index.ts"],
            "@caspian2026/embedjs-loader-confluence": ["loaders/embedjs-loader-confluence/src/index.ts"],
            "@caspian2026/embedjs-loader-csv": ["loaders/embedjs-loader-csv/src/index.ts"],
            "@caspian2026/embedjs-loader-image": ["loaders/embedjs-loader-image/src/index.ts"],
            "@caspian2026/embedjs-loader-markdown": ["loaders/embedjs-loader-markdown/src/index.ts"],
            "@caspian2026/embedjs-loader-msoffice": ["loaders/embedjs-loader-msoffice/src/index.ts"],
            "@caspian2026/embedjs-loader-pdf": ["loaders/embedjs-loader-pdf/src/index.ts"],
            "@caspian2026/embedjs-loader-sitemap": ["loaders/embedjs-loader-sitemap/src/index.ts"],
            "@caspian2026/embedjs-loader-web": ["loaders/embedjs-loader-web/src/index.ts"],
            "@caspian2026/embedjs-loader-xml": ["loaders/embedjs-loader-xml/src/index.ts"],
            "@caspian2026/embedjs-loader-youtube": ["loaders/embedjs-loader-youtube/src/index.ts"],
            "@caspian2026/embedjs-mistral": ["models/embedjs-mistral/src/index.ts"],
            "@caspian2026/embedjs-ollama": ["models/embedjs-ollama/src/index.ts"],
            "@caspian2026/embedjs-openai": ["models/embedjs-openai/src/index.ts"],
            "@caspian2026/embedjs-utils": ["core/embedjs-utils/src/index.ts"],
            "@caspian2026/embedjs-vertexai": ["models/embedjs-vertexai/src/index.ts"]
        }
    },
    "exclude": ["node_modules", "tmp"]
}
